{
  "schema_version": "1.0",
  "product_id": "lawtasksai",
  "product_name": "LawTasksAI",
  "official_domain": "lawtasksai.com",
  "official_github_repo": "https://github.com/laudoluxDev/lawtasksai-mcp",
  "official_package": "@tasksai/install",
  "installer": {
    "preferred": "npx",
    "npx": {
      "command": "npx",
      "args": [
        "@tasksai/install",
        "lawtasksai",
        "--source",
        "https://github.com/laudoluxDev/lawtasksai-mcp"
      ],
      "requires": [
        "node",
        "npm",
        "npx"
      ]
    },
    "fallbacks": {
      "macos": {
        "type": "download",
        "url": "https://github.com/laudoluxDev/lawtasksai-mcp/releases/latest/download/LawTasksAI-Setup",
        "user_action_required": [
          "approve browser download if prompted",
          "open the downloaded installer",
          "approve macOS security prompts if shown"
        ]
      },
      "windows": {
        "type": "download",
        "url": "https://github.com/laudoluxDev/lawtasksai-mcp/releases/latest/download/LawTasksAI-Setup.exe",
        "user_action_required": [
          "approve browser download if prompted",
          "approve Windows SmartScreen or UAC prompts",
          "follow the installer wizard"
        ]
      }
    }
  },
  "supported_clients": [
    "claude_desktop",
    "cursor",
    "windsurf",
    "codex"
  ],
  "auth": {
    "method": "browser_device_flow",
    "connect_url": "https://lawtasksai.com/connect",
    "fallback": "license_key"
  },
  "security": {
    "require_domain_verification": true,
    "require_repo_verification": true,
    "disallow_arbitrary_manifest_commands": true,
    "native_installer_user_approval_required": true
  },
  "health_check": {
    "command": "npx",
    "args": [
      "@tasksai/install",
      "lawtasksai",
      "doctor"
    ]
  },
  "uninstall": {
    "command": "npx",
    "args": [
      "@tasksai/install",
      "lawtasksai",
      "uninstall"
    ]
  },
  "support": {
    "url": "https://lawtasksai.com/support",
    "email": "support@lawtasksai.com"
  }
}
